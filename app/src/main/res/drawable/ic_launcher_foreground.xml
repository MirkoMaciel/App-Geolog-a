<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícono "Perfil de horizontes": monolito de suelo con sus horizontes
  (O humus, A, Bt con óxido de hierro y C con gravas), raíces y pasto.
  Colores: paleta "Cartografía y Estratos" + marrones 10YR de la carta Munsell.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Escala y centra el dibujo dentro de la zona segura de 66 dp -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.86"
        android:scaleY="0.86"
        android:translateY="1.7">

    <group android:name="perfil">
        <clip-path android:pathData="M40,27h28a7,7 0,0 1,7 7v42a7,7 0,0 1,-7 7h-28a7,7 0,0 1,-7 -7v-42a7,7 0,0 1,7 -7z" />

        <!-- Horizonte O (humus) -->
        <path android:fillColor="#2B2620" android:pathData="M33,27h42v7h-42z" />
        <!-- Horizonte A (10YR 3/2) -->
        <path android:fillColor="#4A3D30" android:pathData="M33,34h42v13h-42z" />
        <!-- Horizonte Bt (óxido de hierro) -->
        <path android:fillColor="#C85A17" android:pathData="M33,47h42v17h-42z" />
        <!-- Horizonte C (10YR 7/3) -->
        <path android:fillColor="#BBA88E" android:pathData="M33,64h42v19h-42z" />

        <!-- Límites ondulados entre horizontes -->
        <path
            android:pathData="M33,47 Q40,45 47,47 T61,47 T75,47"
            android:strokeWidth="1.2"
            android:strokeColor="#592B2620" />
        <path
            android:pathData="M33,64 Q41,62 48,64.5 T62,63.5 T75,64.5"
            android:strokeWidth="1.2"
            android:strokeColor="#593B1604" />

        <!-- Gravas del horizonte C -->
        <path
            android:fillColor="#8A939B"
            android:pathData="M38.4,72a2.6,2.6 0,1 0,5.2 0a2.6,2.6 0,1 0,-5.2 0z
                M54.8,77a3.2,3.2 0,1 0,6.4 0a3.2,3.2 0,1 0,-6.4 0z
                M65,69.5a2,2 0,1 0,4 0a2,2 0,1 0,-4 0z
                M46.4,79a1.6,1.6 0,1 0,3.2 0a1.6,1.6 0,1 0,-3.2 0z" />

        <!-- Moteados claros en el Bt -->
        <path
            android:fillColor="#B3F4F1EA"
            android:pathData="M44.1,55a0.9,0.9 0,1 0,1.8 0a0.9,0.9 0,1 0,-1.8 0z
                M61.1,52a0.9,0.9 0,1 0,1.8 0a0.9,0.9 0,1 0,-1.8 0z
                M53.1,59a0.9,0.9 0,1 0,1.8 0a0.9,0.9 0,1 0,-1.8 0z" />

        <!-- Raíces -->
        <path
            android:pathData="M46,30 C46,37 43,40 44,46 M46,36 C49,39 49,42 52,45 M60,30 C60,37 63,41 61,50 M61,39 C58,42 57,45 58,48"
            android:strokeWidth="1.1"
            android:strokeColor="#BFF4F1EA"
            android:strokeLineCap="round" />
    </group>

    <!-- Contorno del monolito (Caliza) -->
    <path
        android:pathData="M40,27h28a7,7 0,0 1,7 7v42a7,7 0,0 1,-7 7h-28a7,7 0,0 1,-7 -7v-42a7,7 0,0 1,7 -7z"
        android:strokeWidth="2.2"
        android:strokeColor="#F4F1EA" />

    <!-- Pasto (Olivino) -->
    <path
        android:fillColor="#6B8E23"
        android:pathData="M37,27 l1.5,-5 l1.5,5z M43,27 l2,-6 l1,6z M50,27 l1,-4 l2,4z M57,27 l2,-6.5 l1,6.5z M64,27 l1,-4.5 l2,4.5z M70,27 l1.5,-5.5 l1.5,5.5z"
        android:strokeWidth="1.6"
        android:strokeColor="#6B8E23"
        android:strokeLineJoin="round" />
    </group>
</vector>
